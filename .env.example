# Copy to .env and tweak. All values are optional.

# Port the API / production server listens on.
PORT=3001

# Where the SQLite database lives.
DB_PATH=data/club.db

# Name shown in the header + browser tab.
CLUB_NAME=The Book Club
CLUB_TAGLINE=One book a month. Strong opinions guaranteed.

# Optional shared secret required to join as a new member.
# Leave empty and anyone with the link can add themselves.
CLUB_PASSCODE=

# Set to "1" to skip loading the demo club on first boot.
SEED_DEMO=1
