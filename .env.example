# Copy to .env and tweak. All values are optional.

# Port the API / production server listens on.
PORT=3001

# Address to bind. Use 127.0.0.1 when a reverse proxy (Caddy) is in front,
# so the app port cannot be reached directly from the network.
HOST=0.0.0.0

# Where the SQLite database lives.
DB_PATH=data/club.db

# Name shown in the header + browser tab.
CLUB_NAME=3SixBookClub

# Shown in the footer under the name.
CLUB_TAGLINE=One book a month.

# Optional shared secret required to join as a new member.
# Leave empty and anyone with the link can add themselves.
CLUB_PASSCODE=

# Set to "0" to skip loading the demo club on first boot.
SEED_DEMO=1
